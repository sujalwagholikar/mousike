# Copy to .env. Leave Gemini blank for fully local recommendation ranking.
GEMINI_API_KEY=
# Gemini model is pinned in recommender.py: gemini-3.5-flash-lite
MOUSIKE_HOST=127.0.0.1
MOUSIKE_PORT=8000
MOUSIKE_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# On Vercel, *.vercel.app hosts are allowed automatically.
# For YOUR custom domain, add it above e.g. ,music.example.com

# concept works immediately without model downloads. To enable neural vectors:
# 1. pip install -r requirements-embeddings.txt
# 2. Set this to transformer and restart. Initial model download needs Internet.
MOUSIKE_EMBEDDINGS=concept
MOUSIKE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional binary overrides (typically leave blank). Vercel dependencies bundle both.
# MOUSIKE_NODE_PATH=/path/to/node
# MOUSIKE_FFMPEG_PATH=/path/to/ffmpeg

# Enable BgUtils script based PO tokens (default true)
MOUSIKE_POT_ENABLED=true
